{
  "expo": {
    "name": "Moklet Event Center",
    "slug": "mec-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.webp",
    "userInterfaceStyle": "light",
    "scheme": "mec-front",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.sch.moklet.mecfront"
    },
    "android": {
      "package": "id.sch.moklet.mecfront",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.webp"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ]
  }
}
